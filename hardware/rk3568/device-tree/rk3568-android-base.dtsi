		num-viewport = <0x8>;
		num-ob-windows = <0x2>;
		max-link-speed = <0x3>;
		msi-map = <0x2000 0xb7 0x2000 0x1000>;
		num-lanes = <0x2>;
		phys = <&pcie30phy>;
		phy-names = "pcie-phy";
		power-domains = <&power 0xf>;
		ranges = <0x800 0x0 0xf0000000 0x0 0xf0000000 0x0 0x100000 0x81000000
			0x0 0xf0100000 0x0 0xf0100000 0x0 0x100000 0x82000000 0x0
			0xf0200000 0x0 0xf0200000 0x0 0x1e00000 0xc3000000 0x3 0x80000000
			0x3 0x80000000 0x0 0x40000000>;
		reg = <0x3 0xc0800000 0x0 0x400000 0x0 0xfe280000 0x0 0x10000>;
		reg-names = "pcie-dbi", "pcie-apb";
		resets = <&cru 0xc1>;
		reset-names = "pipe";
		status = "okay";
		reset-gpios = <&gpio2 30 0>;
		vpcie3v3-supply = <&vcc3v3_pcie>;

		pcie3x2_intc: legacy-interrupt-controller {
			interrupt-controller;
			#address-cells = <0x0>;
			#interrupt-cells = <0x1>;
			interrupt-parent = <&gic>;
			interrupts = <0x0 0xa2 0x1>;
		};
	};

	gmac0: ethernet@fe2a0000 {
		compatible = "rockchip,rk3568-gmac", "snps,dwmac-4.20a";
		reg = <0x0 0xfe2a0000 0x0 0x10000>;
		interrupts = <0x0 0x1b 0x4 0x0 0x18 0x4>;
		interrupt-names = "macirq", "eth_wake_irq";
		rockchip,grf = <&grf>;
		clocks = <&cru 0x182>,
			<&cru 0x185>,
			<&cru 0x185>,
			<&cru 0xb8>,
			<&cru 0xb4>,
			<&cru 0xb5>,
			<&cru 0x185>,
			<&cru 0xb9>,
			<&cru 0xac>;
		clock-names = "stmmaceth", "mac_clk_rx", "mac_clk_tx", "clk_mac_refout", "aclk_mac", "pclk_mac", "clk_mac_speed", "ptp_ref", "pclk_xpcs";
		resets = <&cru 0xd7>;
		reset-names = "stmmaceth";
		snps,mixed-burst;
		snps,tso;
		snps,axi-config = <&gmac0_stmmac_axi_setup>;
		snps,mtl-rx-config = <&gmac0_mtl_rx_setup>;
		snps,mtl-tx-config = <&gmac0_mtl_tx_setup>;
		status = "disabled";
		phy-mode = "rgmii";
		clock_in_out = "output";
		snps,reset-gpio = <&gpio2 0x1b 0x1>;
		snps,reset-active-low;
		snps,reset-delays-us = <0x0 0x4e20 0x186a0>;
		assigned-clocks = <&cru 0x185>, <&cru 0x182>;
		assigned-clock-parents = <&cru 0x183>, <&cru 0xb6>;
		assigned-clock-rates = <0 125000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&gmac0_miim>,
			<&gmac0_tx_bus2>,
			<&gmac0_rx_bus2>,
			<&gmac0_rgmii_clk>,
			<&gmac0_rgmii_bus>;
		tx_delay = <0x3c>;
		rx_delay = <0x2f>;
		phy-handle = <&rgmii_phy0>;

		mdio0: mdio {
			compatible = "snps,dwmac-mdio";
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			rgmii_phy0: phy@0 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <0x0>;
			};
		};

		gmac0_stmmac_axi_setup: stmmac-axi-config {
			snps,wr_osr_lmt = <0x4>;
			snps,rd_osr_lmt = <0x8>;
			snps,blen = <0x0 0x0 0x0 0x0 0x10 0x8 0x4>;
		};

		gmac0_mtl_rx_setup: rx-queues-config {
			snps,rx-queues-to-use = <0x1>;

			queue0 {
			};
		};

		gmac0_mtl_tx_setup: tx-queues-config {
			snps,tx-queues-to-use = <0x1>;

			queue0 {
			};
		};
	};

