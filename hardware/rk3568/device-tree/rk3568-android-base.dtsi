	gmac1: ethernet@fe010000 {
		compatible = "rockchip,rk3568-gmac", "snps,dwmac-4.20a";
		reg = <0x0 0xfe010000 0x0 0x10000>;
		interrupts = <0x0 0x20 0x4 0x0 0x1d 0x4>;
		interrupt-names = "macirq", "eth_wake_irq";
		rockchip,grf = <&grf>;
		clocks = <&cru 0x186>,
			<&cru 0x189>,
			<&cru 0x189>,
			<&cru 0xc7>,
			<&cru 0xc3>,
			<&cru 0xc4>,
			<&cru 0x189>,
			<&cru 0xc8>,
			<&cru 0xac>;
		clock-names = "stmmaceth", "mac_clk_rx", "mac_clk_tx", "clk_mac_refout", "aclk_mac", "pclk_mac", "clk_mac_speed", "ptp_ref", "pclk_xpcs";
		resets = <&cru 0xec>;
		reset-names = "stmmaceth";
		snps,mixed-burst;
		snps,tso;
		snps,axi-config = <&gmac1_stmmac_axi_setup>;
		snps,mtl-rx-config = <&gmac1_mtl_rx_setup>;
		snps,mtl-tx-config = <&gmac1_mtl_tx_setup>;
		status = "okay";
		phy-mode = "rgmii";
		clock_in_out = "input";
		snps,reset-gpio = <&gpio3 0x8 0x1>;
		snps,reset-active-low;
		snps,reset-delays-us = <0x0 0x4e20 0x186a0>;
		assigned-clocks = <&cru 0x189>, <&cru 0x186>;
		assigned-clock-parents = <&cru 0x187>, <&cru 0xc5>;
		assigned-clock-rates = <0 125000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&gmac1m1_miim>,
			<&gmac1m1_tx_bus2>,
			<&gmac1m1_rx_bus2>,
			<&gmac1m1_rgmii_clk>,
			<&gmac1m1_rgmii_bus>;
		tx_delay = <0x38>;
		rx_delay = <0xe>;
		phy-handle = <&rgmii_phy1>;

		mdio1: mdio {
			compatible = "snps,dwmac-mdio";
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			rgmii_phy1: phy@0 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <0x0>;
			};
		};

		gmac1_stmmac_axi_setup: stmmac-axi-config {
			snps,wr_osr_lmt = <0x4>;
			snps,rd_osr_lmt = <0x8>;
			snps,blen = <0x0 0x0 0x0 0x0 0x10 0x8 0x4>;
		};

		gmac1_mtl_rx_setup: rx-queues-config {
			snps,rx-queues-to-use = <0x1>;

			queue0 {
			};
		};

		gmac1_mtl_tx_setup: tx-queues-config {
			snps,tx-queues-to-use = <0x1>;

			queue0 {
			};
		};
	};

	vop: vop@fe040000 {
		compatible = "rockchip,rk3568-vop";
		reg = <0x0 0xfe040000 0x0 0x3000 0x0 0xfe044000 0x0 0x1000>;
		reg-names = "regs", "gamma_lut";
		rockchip,grf = <&grf>;
		interrupts = <0x0 0x94 0x4>;
		clocks = <&cru 0xdd>, <&cru 0xde>, <&cru 0xdf>, <&cru 0xe0>, <&cru 0xe1>;
		clock-names = "aclk_vop", "hclk_vop", "dclk_vp0", "dclk_vp1", "dclk_vp2";
		iommus = <&vop_mmu>;
		power-domains = <&power 0x9>;
		assigned-clocks = <&cru 0xdf>, <&cru 0xe0>;
		assigned-clock-parents = <&pmucru 0x2>, <&cru 0x5>;
		support-multi-area;

		vop_out: ports {
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			vp0: port@0 {
				rockchip,primary-plane = <0x5>;
				rockchip,plane-mask = <0x2a>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				reg = <0x0>;

				vp0_out_dsi0: endpoint@0 {
					reg = <0x0>;
					remote-endpoint = <&dsi0_in_vp0>;
				};

				vp0_out_dsi1: endpoint@1 {
					reg = <0x1>;
					remote-endpoint = <&dsi1_in_vp0>;
				};

				vp0_out_edp: endpoint@2 {
					reg = <0x2>;
					remote-endpoint = <&edp_in_vp0>;
				};

				vp0_out_hdmi: endpoint@3 {
					reg = <0x3>;
					remote-endpoint = <&hdmi_in_vp0>;
				};
			};

			vp1: port@1 {
				rockchip,primary-plane = <0x4>;
				rockchip,plane-mask = <0x15>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				reg = <0x1>;

				vp1_out_dsi0: endpoint@0 {
					reg = <0x0>;
					remote-endpoint = <&dsi0_in_vp1>;
				};

				vp1_out_dsi1: endpoint@1 {
					reg = <0x1>;
					remote-endpoint = <&dsi1_in_vp1>;
				};

				vp1_out_edp: endpoint@2 {
					reg = <0x2>;
					remote-endpoint = <&edp_in_vp1>;
				};

				vp1_out_hdmi: endpoint@3 {
					reg = <0x3>;
					remote-endpoint = <&hdmi_in_vp1>;
				};

				vp1_out_lvds: endpoint@4 {
					reg = <0x4>;
					remote-endpoint = <&lvds_in_vp1>;
				};
			};

			vp2: port@2 {
				rockchip,primary-plane = <0x0>;
				rockchip,plane-mask = <0x0>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				reg = <0x2>;

				vp2_out_lvds: endpoint@0 {
					reg = <0x0>;
					remote-endpoint = <&lvds_in_vp2>;
				};

				vp2_out_rgb: endpoint@1 {
					reg = <0x1>;
					remote-endpoint = <&rgb_in_vp2>;
				};
			};
		};
	};

	vop_mmu: iommu@fe043e00 {
		compatible = "rockchip,iommu-v2";
