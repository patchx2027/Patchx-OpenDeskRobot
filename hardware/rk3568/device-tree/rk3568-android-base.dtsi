/* Reconstructed Android 4.19 baseline; board wiring is in board/ includes. */
/ {
	interrupt-parent = <&gic>;
	#address-cells = <0x2>;
	#size-cells = <0x2>;

	memory {
		reg = <0x0 0x200000 0x0 0x8200000 0x0 0x9400000 0x0 0xe6c00000
			0x1 0xf0000000 0x0 0x10000000 0x0 0x0 0x0 0x0
			0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0
			0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0
			0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0
			0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0>;
		device_type = "memory";
	};

