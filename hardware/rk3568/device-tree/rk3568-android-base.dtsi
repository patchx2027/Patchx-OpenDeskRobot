	aliases {
		csi2dphy0 = "/csi2-dphy0";
		csi2dphy1 = "/csi2-dphy1";
		csi2dphy2 = "/csi2-dphy2";
		dsi0 = "/dsi@fe060000";
		dsi1 = "/dsi@fe070000";
		ethernet0 = "/ethernet@fe2a0000";
		ethernet1 = "/ethernet@fe010000";
		gpio0 = "/pinctrl/gpio@fdd60000";
		gpio1 = "/pinctrl/gpio@fe740000";
		gpio2 = "/pinctrl/gpio@fe750000";
		gpio3 = "/pinctrl/gpio@fe760000";
		gpio4 = "/pinctrl/gpio@fe770000";
		i2c0 = "/i2c@fdd40000";
		i2c1 = "/i2c@fe5a0000";
		i2c2 = "/i2c@fe5b0000";
		i2c3 = "/i2c@fe5c0000";
		i2c4 = "/i2c@fe5d0000";
		i2c5 = "/i2c@fe5e0000";
		mmc0 = "/dwmmc@fe2b0000";
		mmc1 = "/dwmmc@fe2c0000";
		mmc2 = "/sdhci@fe310000";
		mmc3 = "/dwmmc@fe000000";
		serial0 = "/serial@fdd50000";
		serial1 = "/serial@fe650000";
		serial2 = "/serial@fe660000";
		serial3 = "/serial@fe670000";
		serial4 = "/serial@fe680000";
		serial5 = "/serial@fe690000";
		serial6 = "/serial@fe6a0000";
		serial7 = "/serial@fe6b0000";
		serial8 = "/serial@fe6c0000";
		serial9 = "/serial@fe6d0000";
		spi0 = "/spi@fe610000";
		spi1 = "/spi@fe620000";
		spi2 = "/spi@fe630000";
		spi3 = "/spi@fe640000";
		spi4 = "/sfc@fe300000";
	};

	cpus {
		#address-cells = <0x2>;
		#size-cells = <0x0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0 0x0>;
			enable-method = "psci";
			clocks = <&scmi_clk 0x0>;
			operating-points-v2 = <&cpu0_opp_table>;
			cpu-idle-states = <&CPU_SLEEP>;
			#cooling-cells = <0x2>;
			dynamic-power-coefficient = <0xbb>;
			cpu-supply = <&vdd_cpu>;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0 0x100>;
			enable-method = "psci";
			clocks = <&scmi_clk 0x0>;
			operating-points-v2 = <&cpu0_opp_table>;
			cpu-idle-states = <&CPU_SLEEP>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0 0x200>;
			enable-method = "psci";
			clocks = <&scmi_clk 0x0>;
			operating-points-v2 = <&cpu0_opp_table>;
			cpu-idle-states = <&CPU_SLEEP>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0 0x300>;
			enable-method = "psci";
			clocks = <&scmi_clk 0x0>;
			operating-points-v2 = <&cpu0_opp_table>;
			cpu-idle-states = <&CPU_SLEEP>;
		};

		idle-states {
			entry-method = "psci";

			CPU_SLEEP: cpu-sleep {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x64>;
				exit-latency-us = <0x78>;
				min-residency-us = <0x3e8>;
			};
		};
	};

	cpu0_opp_table: cpu0-opp-table {
		compatible = "operating-points-v2";
		opp-shared;
		mbist-vmin = <0xc96a8 0xdbba0 0xe7ef0>;
		nvmem-cells = <&cpu_leakage>, <&core_pvtm>, <&mbist_vmin>;
		nvmem-cell-names = "leakage", "pvtm", "mbist-vmin";
		rockchip,pvtm-voltage-sel = <0x0 0x14820 0x0 0x14821 0x153d8 0x1 0x153d9 0x16378
			0x2 0x16379 0x186a0 0x3>;
		rockchip,pvtm-freq = <0x639c0>;
		rockchip,pvtm-volt = <0xdbba0>;
		rockchip,pvtm-ch = <0x0 0x5>;
		rockchip,pvtm-sample-time = <0x3e8>;
		rockchip,pvtm-number = <0xa>;
		rockchip,pvtm-error = <0x3e8>;
		rockchip,pvtm-ref-temp = <0x28>;
		rockchip,pvtm-temp-prop = <0x1a 0x1a>;
		rockchip,thermal-zone = "soc-thermal";
		rockchip,temp-hysteresis = <0x2710>;
		rockchip,low-temp = <0x3a98>;
		rockchip,low-temp-adjust-volt = <0x0 0x648 0x124f8 0x649 0x708 0x61a8>;

		opp-408000000 {
			opp-hz = <0x0 0x18519600>;
			opp-microvolt = <0xcf850 0xcf850 0x118c30>;
			clock-latency-ns = <0x9c40>;
		};

		opp-600000000 {
			opp-hz = <0x0 0x23c34600>;
			opp-microvolt = <0xcf850 0xcf850 0x118c30>;
			clock-latency-ns = <0x9c40>;
		};

		opp-816000000 {
			opp-hz = <0x0 0x30a32c00>;
			opp-microvolt = <0xcf850 0xcf850 0x118c30>;
			clock-latency-ns = <0x9c40>;
			opp-suspend;
		};

		opp-1104000000 {
			opp-hz = <0x0 0x41cdb400>;
			opp-microvolt = <0xdbba0 0xdbba0 0x118c30>;
			opp-microvolt-L0 = <0xdbba0 0xdbba0 0x118c30>;
			opp-microvolt-L1 = <0xcf850 0xcf850 0x118c30>;
			opp-microvolt-L2 = <0xcf850 0xcf850 0x118c30>;
			opp-microvolt-L3 = <0xcf850 0xcf850 0x118c30>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1416000000 {
			opp-hz = <0x0 0x54667200>;
			opp-microvolt = <0xfa3e8 0xfa3e8 0x118c30>;
			opp-microvolt-L0 = <0xfa3e8 0xfa3e8 0x118c30>;
			opp-microvolt-L1 = <0xee098 0xee098 0x118c30>;
			opp-microvolt-L2 = <0xe7ef0 0xe7ef0 0x118c30>;
			opp-microvolt-L3 = <0xe1d48 0xe1d48 0x118c30>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1608000000 {
			opp-hz = <0x0 0x5fd82200>;
			opp-microvolt = <0x10c8e0 0x10c8e0 0x118c30>;
			opp-microvolt-L0 = <0x10c8e0 0x10c8e0 0x118c30>;
			opp-microvolt-L1 = <0x100590 0x100590 0x118c30>;
			opp-microvolt-L2 = <0xfa3e8 0xfa3e8 0x118c30>;
			opp-microvolt-L3 = <0xf4240 0xf4240 0x118c30>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1800000000 {
			opp-hz = <0x0 0x6b49d200>;
			opp-microvolt = <0x118c30 0x118c30 0x124f80>;
			opp-microvolt-L0 = <0x118c30 0x118c30 0x124f80>;
			opp-microvolt-L1 = <0x10c8e0 0x10c8e0 0x124f80>;
			opp-microvolt-L2 = <0x106738 0x106738 0x124f80>;
			opp-microvolt-L3 = <0x100590 0x100590 0x124f80>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1992000000 {
			opp-hz = <0x0 0x76bb8200>;
			opp-microvolt = <0x118c30 0x118c30 0x124f80>;
			opp-microvolt-L0 = <0x118c30 0x118c30 0x124f80>;
			opp-microvolt-L1 = <0x118c30 0x118c30 0x124f80>;
			opp-microvolt-L2 = <0x112a88 0x112a88 0x124f80>;
			opp-microvolt-L3 = <0x10c8e0 0x10c8e0 0x124f80>;
			clock-latency-ns = <0x9c40>;
		};
	};

	arm-pmu {
		compatible = "arm,cortex-a55-pmu", "arm,armv8-pmuv3";
		interrupts = <0x0 0xe4 0x4 0x0 0xe5 0x4 0x0 0xe6 0x4 0x0 0xe7 0x4>;
		interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
	};

	cpuinfo {
		compatible = "rockchip,cpuinfo";
		nvmem-cells = <&otp_id>, <&otp_cpu_version>, <&cpu_code>;
		nvmem-cell-names = "id", "cpu-version", "cpu-code";
	};

	firmware {

		firmware_android: android {
			compatible = "android,firmware";
			model = "3568A";
			manufacturer = "ShiMeta";
			hw = "3568A";
			hwver = "V2.0";
		};

		optee: optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};

		scmi: scmi {
			compatible = "arm,scmi-smc";
			shmem = <&scmi_shmem>;
			arm,smc-id = <0x82000010>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			scmi_clk: protocol@14 {
				reg = <0x14>;
				#clock-cells = <0x1>;
				rockchip,clk-init = "Tfr";
			};
		};

		sdei: sdei {
			compatible = "arm,sdei-1.0";
			method = "smc";
		};
	};

	mpp_srv: mpp-srv {
		compatible = "rockchip,mpp-service";
		rockchip,taskqueue-count = <0x6>;
		rockchip,resetgroup-count = <0x6>;
		status = "okay";
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	reserved_memory: reserved-memory {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		drm_logo: drm-logo@00000000 {
			compatible = "rockchip,drm-logo";
			reg = <0x0 0xedf00000 0x0 0x2f7b00>;
		};

		drm_cubic_lut: drm-cubic-lut@00000000 {
			compatible = "rockchip,drm-cubic-lut";
			reg = <0x0 0xeff00000 0x0 0x8000>;
		};

		isp_reserved: isp {
			compatible = "shared-dma-pool";
			inactive;
			reusable;
			size = <0x0 0x10000000>;
			status = "disabled";
		};

		cif_reserved: cif {
			compatible = "shared-dma-pool";
			inactive;
			reusable;
			size = <0x0 0x10000000>;
			status = "disabled";
		};

		linux,cma {
			compatible = "shared-dma-pool";
			inactive;
			reusable;
			reg = <0x0 0x10000000 0x0 0x800000>;
			linux,cma-default;
		};

		reserved: buffer@1f0000000 {
			reg = <0x1 0xf0000000 0x0 0x10000000>;
			no-map;
		};

		ramoops: ramoops@110000 {
			compatible = "ramoops";
			reg = <0x0 0x110000 0x0 0xf0000>;
			record-size = <0x20000>;
			console-size = <0x80000>;
			ftrace-size = <0x0>;
			pmsg-size = <0x50000>;
		};
	};

	rockchip_suspend: rockchip-suspend {
		compatible = "rockchip,pm-rk3568";
		status = "okay";
		rockchip,sleep-debug-en = <0x1>;
		rockchip,sleep-mode-config = <0x5ec>;
		rockchip,wakeup-config = <0x10>;
	};

	rockchip_system_monitor: rockchip-system-monitor {
		compatible = "rockchip,system-monitor";
		rockchip,thermal-zone = "soc-thermal";
	};

	thermal_zones: thermal-zones {

		soc_thermal: soc-thermal {
			polling-delay-passive = <0x14>;
			polling-delay = <0x3e8>;
			sustainable-power = <0x389>;
			thermal-sensors = <&tsadc 0x0>;

			trips {

				threshold: trip-point-0 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				target: trip-point-1 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				soc_crit: soc-crit {
					temperature = <0x1c138>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <&target>;
					cooling-device = <&cpu0 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};

				map1 {
					trip = <&target>;
					cooling-device = <&gpu 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};
			};
		};

		gpu_thermal: gpu-thermal {
			polling-delay-passive = <0x14>;
			polling-delay = <0x3e8>;
			thermal-sensors = <&tsadc 0x1>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x1 0xd 0xf04 0x1 0xe 0xf04 0x1 0xb 0xf04 0x1 0xa 0xf04>;
		arm,no-tick-in-suspend;
	};

	gmac0_clkin: external-gmac0-clock {
		compatible = "fixed-clock";
		clock-frequency = <125000000>;
		clock-output-names = "gmac0_clkin";
		#clock-cells = <0x0>;
	};

	gmac1_clkin: external-gmac1-clock {
		compatible = "fixed-clock";
		clock-frequency = <125000000>;
		clock-output-names = "gmac1_clkin";
		#clock-cells = <0x0>;
	};

	gmac0_xpcsclk: xpcs-gmac0-clock {
		compatible = "fixed-clock";
		clock-frequency = <125000000>;
		clock-output-names = "clk_gmac0_xpcs_mii";
		#clock-cells = <0x0>;
	};

	gmac1_xpcsclk: xpcs-gmac1-clock {
		compatible = "fixed-clock";
		clock-frequency = <125000000>;
		clock-output-names = "clk_gmac1_xpcs_mii";
		#clock-cells = <0x0>;
	};

	i2s1_mclkin_rx: i2s1-mclkin-rx {
		compatible = "fixed-clock";
		#clock-cells = <0x0>;
		clock-frequency = <12288000>;
		clock-output-names = "i2s1_mclkin_rx";
	};

	i2s1_mclkin_tx: i2s1-mclkin-tx {
		compatible = "fixed-clock";
		#clock-cells = <0x0>;
		clock-frequency = <12288000>;
		clock-output-names = "i2s1_mclkin_tx";
	};

	i2s2_mclkin: i2s2-mclkin {
		compatible = "fixed-clock";
		#clock-cells = <0x0>;
		clock-frequency = <12288000>;
		clock-output-names = "i2s2_mclkin";
	};

	i2s3_mclkin: i2s3-mclkin {
		compatible = "fixed-clock";
		#clock-cells = <0x0>;
		clock-frequency = <12288000>;
		clock-output-names = "i2s3_mclkin";
	};

	mpll: mpll {
		compatible = "fixed-clock";
		#clock-cells = <0x0>;
		clock-frequency = <800000000>;
		clock-output-names = "mpll";
	};

	xin24m: xin24m {
		compatible = "fixed-clock";
		#clock-cells = <0x0>;
		clock-frequency = <24000000>;
		clock-output-names = "xin24m";
	};

	xin32k: xin32k {
		compatible = "fixed-clock";
		clock-frequency = <32768>;
		clock-output-names = "xin32k";
		#clock-cells = <0x0>;
		pinctrl-names = "default";
		pinctrl-0 = <&clk32k_out0>;
	};

	scmi_shmem: scmi-shmem@10f000 {
		compatible = "arm,scmi-shmem";
		reg = <0x0 0x10f000 0x0 0x100>;
	};

	sata0: sata@fc000000 {
		compatible = "snps,dwc-ahci";
		reg = <0x0 0xfc000000 0x0 0x1000>;
		clocks = <&cru 0x96>, <&cru 0x97>, <&cru 0x98>;
		clock-names = "sata", "pmalive", "rxoob";
		interrupts = <0x0 0x5e 0x4>;
		interrupt-names = "hostc";
		phys = <&combphy0_us 0x1>;
		phy-names = "sata-phy";
		ports-implemented = <0x1>;
		power-domains = <&power 0xf>;
		status = "disabled";
	};

	sata1: sata@fc400000 {
		compatible = "snps,dwc-ahci";
		reg = <0x0 0xfc400000 0x0 0x1000>;
		clocks = <&cru 0x9b>, <&cru 0x9c>, <&cru 0x9d>;
		clock-names = "sata", "pmalive", "rxoob";
		interrupts = <0x0 0x5f 0x4>;
		interrupt-names = "hostc";
		phys = <&combphy1_usq 0x1>;
		phy-names = "sata-phy";
		ports-implemented = <0x1>;
		power-domains = <&power 0xf>;
		status = "disabled";
	};

	sata2: sata@fc800000 {
		compatible = "snps,dwc-ahci";
		reg = <0x0 0xfc800000 0x0 0x1000>;
		clocks = <&cru 0xa0>, <&cru 0xa1>, <&cru 0xa2>;
		clock-names = "sata", "pmalive", "rxoob";
		interrupts = <0x0 0x60 0x4>;
		interrupt-names = "hostc";
		phys = <&combphy2_psq 0x1>;
		phy-names = "sata-phy";
		ports-implemented = <0x1>;
		power-domains = <&power 0xf>;
		status = "okay";
	};

	usbdrd30: usbdrd {
		compatible = "rockchip,rk3568-dwc3", "rockchip,rk3399-dwc3";
		clocks = <&cru 0xa6>, <&cru 0xa7>, <&cru 0xa5>, <&cru 0x7f>;
		clock-names = "ref_clk", "suspend_clk", "bus_clk", "pipe_clk";
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;
		status = "okay";

		usbdrd_dwc3: dwc3@fcc00000 {
			compatible = "snps,dwc3";
			reg = <0x0 0xfcc00000 0x0 0x400000>;
			interrupts = <0x0 0xa9 0x4>;
			dr_mode = "otg";
			phys = <&u2phy0_otg>, <&combphy0_us 0x4>;
			phy-names = "usb2-phy", "usb3-phy";
			phy_type = "utmi_wide";
			power-domains = <&power 0xf>;
			resets = <&cru 0x94>;
			reset-names = "usb3-otg";
			snps,dis_enblslpm_quirk;
			snps,dis-u1u2-quirk;
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis-del-phy-power-chg-quirk;
			snps,dis-tx-ipgap-linecheck-quirk;
			snps,dis_rxdet_inp3_quirk;
			snps,xhci-trb-ent-quirk;
			status = "okay";
		};
	};

	usbhost30: usbhost {
		compatible = "rockchip,rk3568-dwc3", "rockchip,rk3399-dwc3";
		clocks = <&cru 0xa9>, <&cru 0xaa>, <&cru 0xa8>, <&cru 0x7f>;
		clock-names = "ref_clk", "suspend_clk", "bus_clk", "pipe_clk";
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;
		status = "okay";

		usbhost_dwc3: dwc3@fd000000 {
			compatible = "snps,dwc3";
			reg = <0x0 0xfd000000 0x0 0x400000>;
			interrupts = <0x0 0xaa 0x4>;
			dr_mode = "host";
			phys = <&u2phy0_host>, <&combphy1_usq 0x4>;
			phy-names = "usb2-phy", "usb3-phy";
			phy_type = "utmi_wide";
			power-domains = <&power 0xf>;
			resets = <&cru 0x95>;
			reset-names = "usb3-host";
			snps,dis_enblslpm_quirk;
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis-del-phy-power-chg-quirk;
			snps,dis-tx-ipgap-linecheck-quirk;
			snps,dis_rxdet_inp3_quirk;
			snps,xhci-trb-ent-quirk;
			status = "okay";
		};
	};

	gic: interrupt-controller@fd400000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x3>;
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;
		interrupt-controller;
		reg = <0x0 0xfd400000 0x0 0x10000 0x0 0xfd460000 0x0 0xc0000>;
		interrupts = <0x1 0x9 0x4>;

		its: interrupt-controller@fd440000 {
			compatible = "arm,gic-v3-its";
			msi-controller;
			#msi-cells = <0x1>;
			reg = <0x0 0xfd440000 0x0 0x20000>;
		};
	};

	usb_host0_ehci: usb@fd800000 {
		compatible = "generic-ehci";
		reg = <0x0 0xfd800000 0x0 0x40000>;
		interrupts = <0x0 0x82 0x4>;
		clocks = <&cru 0xbd>, <&cru 0xbe>, <&cru 0xbc>, <&usb2phy1>;
		clock-names = "usbhost", "arbiter", "pclk", "utmi";
		phys = <&u2phy1_otg>;
		phy-names = "usb2-phy";
		status = "okay";
	};

	usb_host0_ohci: usb@fd840000 {
		compatible = "generic-ohci";
		reg = <0x0 0xfd840000 0x0 0x40000>;
		interrupts = <0x0 0x83 0x4>;
		clocks = <&cru 0xbd>, <&cru 0xbe>, <&cru 0xbc>, <&usb2phy1>;
		clock-names = "usbhost", "arbiter", "pclk", "utmi";
		phys = <&u2phy1_otg>;
		phy-names = "usb2-phy";
		status = "okay";
	};

	usb_host1_ehci: usb@fd880000 {
		compatible = "generic-ehci";
		reg = <0x0 0xfd880000 0x0 0x40000>;
		interrupts = <0x0 0x85 0x4>;
		clocks = <&cru 0xbf>, <&cru 0xc0>, <&cru 0xbc>, <&usb2phy1>;
		clock-names = "usbhost", "arbiter", "pclk", "utmi";
		phys = <&u2phy1_host>;
		phy-names = "usb2-phy";
		status = "okay";
	};

	usb_host1_ohci: usb@fd8c0000 {
		compatible = "generic-ohci";
		reg = <0x0 0xfd8c0000 0x0 0x40000>;
		interrupts = <0x0 0x86 0x4>;
		clocks = <&cru 0xbf>, <&cru 0xc0>, <&cru 0xbc>, <&usb2phy1>;
		clock-names = "usbhost", "arbiter", "pclk", "utmi";
		phys = <&u2phy1_host>;
		phy-names = "usb2-phy";
		status = "okay";
	};

	xpcs: syscon@fda00000 {
		compatible = "rockchip,rk3568-xpcs", "syscon";
		reg = <0x0 0xfda00000 0x0 0x200000>;
		status = "disabled";
	};

	pmugrf: syscon@fdc20000 {
		compatible = "rockchip,rk3568-pmugrf", "syscon", "simple-mfd";
		reg = <0x0 0xfdc20000 0x0 0x10000>;

		pmu_io_domains: io-domains {
			compatible = "rockchip,rk3568-pmu-io-voltage-domain";
			status = "okay";
			pmuio2-supply = <&vcc3v3_pmu>;
			vccio1-supply = <&vccio_acodec>;
			vccio3-supply = <&vccio_sd>;
			vccio4-supply = <&vcc_1v8>;
			vccio5-supply = <&vcc_3v3>;
			vccio6-supply = <&vcc_1v8>;
			vccio7-supply = <&vcc_3v3>;
		};

		reboot_mode: reboot-mode {
			compatible = "syscon-reboot-mode";
			offset = <0x200>;
			mode-bootloader = <0x5242c309>;
			mode-charge = <0x5242c30b>;
			mode-fastboot = <0x5242c303>;
			mode-loader = <0x5242c301>;
			mode-normal = <0x5242c300>;
			mode-recovery = <0x5242c303>;
			mode-ums = <0x5242c30c>;
			mode-panic = <0x5242c307>;
			mode-watchdog = <0x5242c308>;
		};
	};

	pipegrf: syscon@fdc50000 {
		compatible = "rockchip,rk3568-pipegrf", "syscon";
		reg = <0x0 0xfdc50000 0x0 0x1000>;
	};

	grf: syscon@fdc60000 {
		compatible = "rockchip,rk3568-grf", "syscon", "simple-mfd";
		reg = <0x0 0xfdc60000 0x0 0x10000>;

		io_domains: io-domains {
			compatible = "rockchip,rk3568-io-voltage-domain";
			status = "disabled";
		};

		lvds: lvds {
			compatible = "rockchip,rk3568-lvds";
			phys = <&video_phy0>;
			phy-names = "phy";
			status = "disabled";

			ports {
				#address-cells = <0x1>;
				#size-cells = <0x0>;

				port@0 {
					reg = <0x0>;
					#address-cells = <0x1>;
					#size-cells = <0x0>;

					lvds_in_vp1: endpoint@1 {
						reg = <0x1>;
						remote-endpoint = <&vp1_out_lvds>;
						status = "disabled";
					};

					lvds_in_vp2: endpoint@2 {
						reg = <0x2>;
						remote-endpoint = <&vp2_out_lvds>;
						status = "disabled";
					};
				};

				port@1 {
					reg = <0x1>;

					lvds_out_panel: endpoint {
						remote-endpoint = <&panel_in_lvds>;
					};
				};
			};
		};

		rgb: rgb {
			compatible = "rockchip,rk3568-rgb";
			pinctrl-names = "default";
			pinctrl-0 = <&lcdc_ctl>;
			status = "disabled";

			ports {
				#address-cells = <0x1>;
				#size-cells = <0x0>;

				port@0 {
					reg = <0x0>;
					#address-cells = <0x1>;
					#size-cells = <0x0>;

					rgb_in_vp2: endpoint@2 {
						reg = <0x2>;
						remote-endpoint = <&vp2_out_rgb>;
						status = "disabled";
					};
				};
			};
		};
	};

	pipe_phy_grf0: syscon@fdc70000 {
		compatible = "rockchip,pipe-phy-grf", "syscon";
		reg = <0x0 0xfdc70000 0x0 0x1000>;
	};

	pipe_phy_grf1: syscon@fdc80000 {
		compatible = "rockchip,pipe-phy-grf", "syscon";
		reg = <0x0 0xfdc80000 0x0 0x1000>;
	};

	pipe_phy_grf2: syscon@fdc90000 {
		compatible = "rockchip,pipe-phy-grf", "syscon";
		reg = <0x0 0xfdc90000 0x0 0x1000>;
	};

	usb2phy0_grf: syscon@fdca0000 {
		compatible = "rockchip,rk3568-usb2phy-grf", "syscon";
		reg = <0x0 0xfdca0000 0x0 0x8000>;
	};

	usb2phy1_grf: syscon@fdca8000 {
		compatible = "rockchip,rk3568-usb2phy-grf", "syscon";
		reg = <0x0 0xfdca8000 0x0 0x8000>;
	};

	edp_phy_grf: syscon@fdcb0000 {
		compatible = "rockchip,rk3568-edp-phy-grf", "syscon", "simple-mfd";
		reg = <0x0 0xfdcb0000 0x0 0x100>;
		clocks = <&cru 0x192>;

		edp_phy: edp-phy {
			compatible = "rockchip,rk3568-edp-phy";
			clocks = <&pmucru 0x29>;
			clock-names = "refclk";
			#phy-cells = <0x0>;
			status = "okay";
		};
	};

	pcie30_phy_grf: syscon@fdcb8000 {
		compatible = "rockchip,pcie30-phy-grf", "syscon";
		reg = <0x0 0xfdcb8000 0x0 0x10000>;
	};

	sram: sram@fdcc0000 {
		compatible = "mmio-sram";
		reg = <0x0 0xfdcc0000 0x0 0xb000>;
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		ranges = <0x0 0x0 0xfdcc0000 0xb000>;

		rkvdec_sram: rkvdec-sram@0 {
			reg = <0x0 0xb000>;
		};
	};

	pmucru: clock-controller@fdd00000 {
		compatible = "rockchip,rk3568-pmucru";
		reg = <0x0 0xfdd00000 0x0 0x1000>;
		rockchip,grf = <&grf>;
		rockchip,pmugrf = <&pmugrf>;
		#clock-cells = <0x1>;
		#reset-cells = <0x1>;
		assigned-clocks = <&pmucru 0x32>;
		assigned-clock-parents = <&pmucru 0x5>;
	};

	cru: clock-controller@fdd20000 {
		compatible = "rockchip,rk3568-cru";
		reg = <0x0 0xfdd20000 0x0 0x1000>;
		rockchip,grf = <&grf>;
		#clock-cells = <0x1>;
		#reset-cells = <0x1>;
		assigned-clocks = <&pmucru 0x5>,
			<&cru 0x106>,
			<&cru 0x10b>,
			<&pmucru 0x1>,
			<&pmucru 0x2b>,
			<&cru 0x3>,
			<&cru 0x19b>,
			<&cru 0x9>,
			<&cru 0x19c>,
			<&cru 0x19d>,
			<&cru 0x1a1>,
			<&cru 0x19e>,
			<&cru 0x19f>,
			<&cru 0x1a0>,
			<&cru 0x4>,
			<&cru 0x10d>,
			<&cru 0x10e>,
			<&cru 0x173>,
			<&cru 0x174>,
			<&cru 0x175>,
			<&cru 0x176>,
			<&cru 0xc9>,
			<&cru 0xca>,
			<&cru 0x6>,
			<&cru 0x7e>,
			<&cru 0x7f>,
			<&cru 0x3d>,
			<&cru 0x41>,
			<&cru 0x45>,
			<&cru 0x49>,
			<&cru 0x4d>,
			<&cru 0x4d>,
			<&cru 0x55>,
			<&cru 0x51>,
			<&cru 0x5d>,
			<&cru 0xdd>;
		assigned-clock-rates = <32768 300000000 300000000 200000000 100000000 1000000000 500000000 333000000
			250000000 125000000 100000000 62500000 50000000 25000000 1188000000 150000000
			100000000 500000000 400000000 150000000 100000000 300000000 150000000 1200000000
			400000000 100000000 1188000000 1188000000 1188000000 1188000000 1188000000 1188000000
			1188000000 1188000000 1188000000 500000000>;
		assigned-clock-parents = <&pmucru 0x8>, <&cru 0x4>, <&cru 0x4>;
	};

	i2c0: i2c@fdd40000 {
		compatible = "rockchip,rk3399-i2c";
		reg = <0x0 0xfdd40000 0x0 0x1000>;
		clocks = <&pmucru 0x7>, <&pmucru 0x2d>;
		clock-names = "i2c", "pclk";
		interrupts = <0x0 0x2e 0x4>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		vdd_cpu: tcs4525@1c {
			compatible = "tcs,tcs452x";
			reg = <0x1c>;
			vin-supply = <&vcc5v0_sys>;
			regulator-compatible = "fan53555-reg";
			regulator-name = "vdd_cpu";
			regulator-min-microvolt = <712500>;
			regulator-max-microvolt = <1390000>;
			regulator-init-microvolt = <1000000>;
			regulator-ramp-delay = <2300>;
			fcs,suspend-voltage-selector = <0x1>;
			regulator-initial-mode = <0x1>;
			regulator-boot-on;
			regulator-always-on;

			regulator-state-mem {
				regulator-off-in-suspend;
			};
		};

		bq25700: bq25700@6b {
			compatible = "ti,bq25703";
			reg = <0x6b>;
			extcon = <&fusb0>;
			interrupt-parent = <&gpio0>;
			interrupts = <0x12 0x8>;
			ti,charge-current = <0x16e360>;
			ti,max-charge-voltage = <0x7d2ee0>;
			ti,max-input-voltage = <0x1312d00>;
			ti,max-input-current = <0x5b8d80>;
			ti,input-current-sdp = <0x7a120>;
			ti,input-current-dcp = <0x1e8480>;
			ti,input-current-cdp = <0x1e8480>;
			ti,input-current-dc = <0x1e8480>;
			ti,minimum-sys-voltage = <0x663be0>;
			ti,otg-voltage = <0x4c4b40>;
			ti,otg-current = <0x7a120>;
			ti,input-current = <0x7a120>;
			pd-charge-only = <0x0>;
			status = "okay";
		};

		fusb0: fusb30x@22 {
			compatible = "fairchild,fusb302";
			reg = <0x22>;
			pinctrl-names = "default";
			int-n-gpios = <&gpio0 0x8 0x0>;
			charge-dev = <&bq25700>;
			port-num = <0x0>;
			status = "okay";
		};
	};

	uart0: serial@fdd50000 {
		compatible = "rockchip,rk3568-uart", "snps,dw-apb-uart";
		reg = <0x0 0xfdd50000 0x0 0x100>;
		interrupts = <0x0 0x74 0x4>;
		clocks = <&pmucru 0xb>, <&pmucru 0x2c>;
		clock-names = "baudclk", "apb_pclk";
		reg-shift = <0x2>;
		reg-io-width = <0x4>;
		dmas = <&dmac0 0x0>, <&dmac0 0x1>;
		pinctrl-names = "default";
		pinctrl-0 = <&uart0_xfer>;
		status = "okay";
	};

	pwm0: pwm@fdd70000 {
		compatible = "rockchip,rk3568-pwm", "rockchip,rk3328-pwm";
		reg = <0x0 0xfdd70000 0x0 0x10>;
		#pwm-cells = <0x3>;
		pinctrl-names = "active";
		pinctrl-0 = <&pwm0m0_pins>;
		clocks = <&pmucru 0xd>, <&pmucru 0x30>;
		clock-names = "pwm", "pclk";
		status = "disabled";
	};

	pwm1: pwm@fdd70010 {
		compatible = "rockchip,rk3568-pwm", "rockchip,rk3328-pwm";
		reg = <0x0 0xfdd70010 0x0 0x10>;
		#pwm-cells = <0x3>;
		pinctrl-names = "active";
		pinctrl-0 = <&pwm1m0_pins>;
		clocks = <&pmucru 0xd>, <&pmucru 0x30>;
		clock-names = "pwm", "pclk";
		status = "disabled";
	};

	pwm2: pwm@fdd70020 {
		compatible = "rockchip,rk3568-pwm", "rockchip,rk3328-pwm";
		reg = <0x0 0xfdd70020 0x0 0x10>;
		#pwm-cells = <0x3>;
		pinctrl-names = "active";
		pinctrl-0 = <&pwm2m0_pins>;
		clocks = <&pmucru 0xd>, <&pmucru 0x30>;
		clock-names = "pwm", "pclk";
		status = "disabled";
	};

	pwm3: pwm@fdd70030 {
		compatible = "rockchip,remotectl-pwm";
		reg = <0x0 0xfdd70030 0x0 0x10>;
		interrupts = <0x0 0x52 0x4 0x0 0x56 0x4>;
		#pwm-cells = <0x3>;
		pinctrl-names = "default";
		pinctrl-0 = <&pwm3_pins>;
		clocks = <&pmucru 0xd>, <&pmucru 0x30>;
		clock-names = "pwm", "pclk";
		status = "okay";
		remote_pwm_id = <0x3>;
		handle_cpu_id = <0x1>;
		remote_support_psci = <0x0>;

		ir_key1 {
			rockchip,usercode = <0x4040>;
			rockchip,key_table = <0xf2 0xe8 0xba 0x9e 0xf4 0x67 0xf1 0x6c
				0xef 0x69 0xee 0x6a 0xbd 0x66 0xea 0x73
				0xe3 0x72 0xe2 0xd9 0xb2 0x74 0xbc 0x71
				0xec 0x8b 0xbf 0x190 0xe0 0x191 0xe1 0x192
				0xe9 0xb7 0xe6 0xf8 0xe8 0xb9 0xe7 0xba
				0xf0 0x184 0xbe 0x175>;
		};

		ir_key2 {
			rockchip,usercode = <0xff00>;
			rockchip,key_table = <0xf0 0x74 0xad 0x66 0xef 0x8b 0xa7 0x71
				0xa3 0x73 0xab 0x72 0xac 0x9e 0xa4 0xe8
				0xb2 0x67 0xa5 0x6c 0xa8 0x69 0xa0 0x6a
				0xa1 0xf0 0xa9 0xf 0xee 0x68 0xed 0x6d
				0xe8 0x2 0xe4 0x3 0xe0 0x4 0xe9 0x5
				0xe5 0x6 0xe1 0x7 0xea 0x8 0xe6 0x9
				0xe2 0xa 0xe7 0xb 0xeb 0x34 0xe3 0x6f
				0xa6 0x77 0xaa 0xcf 0xec 0x1a2 0xaf 0x1a3>;
		};

		ir_key3 {
			rockchip,usercode = <0x1dcc>;
			rockchip,key_table = <0xee 0xe8 0xf0 0x9e 0xf8 0x67 0xbb 0x6c
				0xef 0x69 0xed 0x6a 0xfc 0x66 0xf1 0x73
				0xfd 0x72 0xb7 0xd9 0xff 0x74 0xf3 0x71
				0xbf 0x8b 0xf9 0x191 0xf5 0x192 0xb3 0x184
				0xbe 0x2 0xba 0x3 0xb2 0x4 0xbd 0x5
				0xf9 0x6 0xb1 0x7 0xfc 0x8 0xf8 0x9
				0xb0 0xa 0xb6 0xb 0xb5 0xe>;
		};
	};

	pmu: power-management@fdd90000 {
		compatible = "rockchip,rk3568-pmu", "syscon", "simple-mfd";
		reg = <0x0 0xfdd90000 0x0 0x1000>;

		power: power-controller {
			compatible = "rockchip,rk3568-power-controller";
			#power-domain-cells = <0x1>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "okay";

			pd_npu@6 {
				reg = <0x6>;
				clocks = <&cru 0x27>, <&cru 0x25>, <&cru 0x26>;
				pm_qos = <0x49>;
			};

			pd_gpu@7 {
				reg = <0x7>;
				clocks = <&cru 0x19>, <&cru 0x1a>;
				pm_qos = <0x4a>;
			};

			pd_vi@8 {
				reg = <0x8>;
				clocks = <&cru 0xcc>, <&cru 0xcd>;
				pm_qos = <0x4b 0x4c 0x4d>;
			};

			pd_vo@9 {
				reg = <0x9>;
				clocks = <&cru 0xda>, <&cru 0xdb>, <&cru 0xdc>;
				pm_qos = <0x4e 0x4f 0x50>;
			};

			pd_rga@10 {
				reg = <0xa>;
				clocks = <&cru 0xf1>, <&cru 0xf2>;
				pm_qos = <0x51 0x52 0x53 0x54 0x55 0x56>;
			};

			pd_vpu@11 {
				reg = <0xb>;
				clocks = <&cru 0xed>;
				pm_qos = <0x57>;
			};

			pd_rkvdec@13 {
				clocks = <&cru 0x107>;
				reg = <0xd>;
				pm_qos = <0x58>;
			};

			pd_rkvenc@14 {
				reg = <0xe>;
				clocks = <&cru 0x102>;
				pm_qos = <0x59 0x5a 0x5b>;
			};

			pd_pipe@15 {
				reg = <0xf>;
				clocks = <&cru 0x7f>;
				pm_qos = <0x5c 0x5d 0x5e 0x5f 0x60 0x61 0x62 0x63>;
			};
		};
	};

	pvtm@fde00000 {
		compatible = "rockchip,rk3568-core-pvtm";
		reg = <0x0 0xfde00000 0x0 0x100>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		pvtm@0 {
			reg = <0x0>;
			clocks = <&cru 0x13>, <&cru 0x1c2>;
			clock-names = "clk", "pclk";
			resets = <&cru 0x1a>, <&cru 0x19>;
			reset-names = "rts", "rst-p";
			thermal-zone = "soc-thermal";
		};
	};

	rknpu: npu@fde40000 {
		compatible = "rockchip,rk3568-rknpu", "rockchip,rknpu";
		reg = <0x0 0xfde40000 0x0 0x10000>;
		interrupts = <0x0 0x97 0x4>;
		clocks = <&scmi_clk 0x2>, <&cru 0x23>, <&cru 0x28>, <&cru 0x29>;
		clock-names = "scmi_clk", "clk", "aclk", "hclk";
		assigned-clocks = <&cru 0x23>;
		assigned-clock-rates = <600000000>;
		resets = <&cru 0x2b>, <&cru 0x2c>;
		reset-names = "srst_a", "srst_h";
		power-domains = <&power 0x6>;
		operating-points-v2 = <&npu_opp_table>;
		iommus = <&rknpu_mmu>;
		status = "okay";
		rknpu-supply = <&vdd_npu>;
	};

	npu_opp_table: npu-opp-table {
		compatible = "operating-points-v2";
		mbist-vmin = <0xc96a8 0xdbba0 0xe7ef0>;
		nvmem-cells = <&npu_leakage>, <&core_pvtm>, <&mbist_vmin>;
		nvmem-cell-names = "leakage", "pvtm", "mbist-vmin";
		rockchip,temp-hysteresis = <0x2710>;
		rockchip,low-temp = <0x2710>;
		rockchip,low-temp-adjust-volt = <0x0 0x3e8 0xc350>;
		rockchip,pvtm-voltage-sel = <0x0 0x14820 0x0 0x14821 0x153d8 0x1 0x153d9 0x16378
			0x2 0x16379 0x186a0 0x3>;
		rockchip,pvtm-ch = <0x0 0x5>;

		opp-200000000 {
			opp-hz = <0x0 0xbebc200>;
			opp-microvolt = <0xcf850 0xcf850 0xf4240>;
		};

		opp-300000000 {
			opp-hz = <0x0 0x11b3dc40>;
			opp-microvolt = <0xcf850 0xcf850 0xf4240>;
		};

		opp-400000000 {
			opp-hz = <0x0 0x17d78400>;
			opp-microvolt = <0xcf850 0xcf850 0xf4240>;
		};

		opp-600000000 {
			opp-hz = <0x0 0x23c34600>;
			opp-microvolt = <0xd59f8 0xd59f8 0xf4240>;
			opp-microvolt-L0 = <0xd59f8 0xd59f8 0xf4240>;
			opp-microvolt-L1 = <0xcf850 0xcf850 0xf4240>;
			opp-microvolt-L2 = <0xcf850 0xcf850 0xf4240>;
			opp-microvolt-L3 = <0xcf850 0xcf850 0xf4240>;
		};

		opp-700000000 {
			opp-hz = <0x0 0x29b92700>;
			opp-microvolt = <0xdbba0 0xdbba0 0xf4240>;
			opp-microvolt-L0 = <0xdbba0 0xdbba0 0xf4240>;
			opp-microvolt-L1 = <0xcf850 0xcf850 0xf4240>;
			opp-microvolt-L2 = <0xcf850 0xcf850 0xf4240>;
			opp-microvolt-L3 = <0xcf850 0xcf850 0xf4240>;
		};

		opp-800000000 {
			opp-hz = <0x0 0x2faf0800>;
			opp-microvolt = <0xe1d48 0xe1d48 0xf4240>;
			opp-microvolt-L0 = <0xe1d48 0xe1d48 0xf4240>;
			opp-microvolt-L1 = <0xdbba0 0xdbba0 0xf4240>;
			opp-microvolt-L2 = <0xd59f8 0xd59f8 0xf4240>;
			opp-microvolt-L3 = <0xd59f8 0xd59f8 0xf4240>;
		};

		opp-900000000 {
			opp-hz = <0x0 0x35a4e900>;
			opp-microvolt = <0xee098 0xee098 0xf4240>;
			opp-microvolt-L0 = <0xee098 0xee098 0xf4240>;
			opp-microvolt-L1 = <0xe7ef0 0xe7ef0 0xf4240>;
			opp-microvolt-L2 = <0xe1d48 0xe1d48 0xf4240>;
			opp-microvolt-L3 = <0xdbba0 0xdbba0 0xf4240>;
		};

		opp-1000000000 {
			opp-hz = <0x0 0x3b9aca00>;
			opp-microvolt = <0xf4240 0xf4240 0x100590>;
			opp-microvolt-L0 = <0xf4240 0xf4240 0x100590>;
			opp-microvolt-L1 = <0xee098 0xee098 0x100590>;
			opp-microvolt-L2 = <0xe7ef0 0xe7ef0 0x100590>;
			opp-microvolt-L3 = <0xe1d48 0xe1d48 0x100590>;
			status = "disabled";
		};
	};

	bus_npu: bus-npu {
		compatible = "rockchip,rk3568-bus";
		rockchip,busfreq-policy = "clkfreq";
		clocks = <&scmi_clk 0x2>;
		clock-names = "bus";
		operating-points-v2 = <&bus_npu_opp_table>;
		status = "okay";
		bus-supply = <&vdd_logic>;
		pvtm-supply = <&vdd_cpu>;
	};

	bus_npu_opp_table: bus-npu-opp-table {
		compatible = "operating-points-v2";
		opp-shared;
		nvmem-cells = <&core_pvtm>;
		nvmem-cell-names = "pvtm";
		rockchip,pvtm-voltage-sel = <0x0 0x14820 0x0 0x14821 0x16378 0x1 0x16379 0x186a0 0x2>;
		rockchip,pvtm-ch = <0x0 0x5>;

		opp-700000000 {
			opp-hz = <0x0 0x29b92700>;
			opp-microvolt = <0xdbba0>;
			opp-microvolt-L0 = <0xdbba0>;
			opp-microvolt-L1 = <0xd59f8>;
			opp-microvolt-L2 = <0xd59f8>;
		};

		opp-900000000 {
			opp-hz = <0x0 0x35a4e900>;
			opp-microvolt = <0xdbba0>;
		};

		opp-1000000000 {
			opp-hz = <0x0 0x3b9aca00>;
			opp-microvolt = <0xe7ef0>;
			opp-microvolt-L0 = <0xe7ef0>;
			opp-microvolt-L1 = <0xe1d48>;
			opp-microvolt-L2 = <0xdbba0>;
		};
	};

	rknpu_mmu: iommu@fde4b000 {
		compatible = "rockchip,iommu-v2";
		reg = <0x0 0xfde4b000 0x0 0x40>;
		interrupts = <0x0 0x97 0x4>;
		interrupt-names = "rknpu_mmu";
		clocks = <&cru 0x28>, <&cru 0x29>;
		clock-names = "aclk", "iface";
		power-domains = <&power 0x6>;
		#iommu-cells = <0x0>;
		status = "okay";
	};

	gpu: gpu@fde60000 {
		compatible = "arm,mali-bifrost";
		reg = <0x0 0xfde60000 0x0 0x4000>;
		interrupts = <0x0 0x27 0x4 0x0 0x29 0x4 0x0 0x28 0x4>;
		interrupt-names = "GPU", "MMU", "JOB";
		upthreshold = <0x28>;
		downdifferential = <0xa>;
		clocks = <&scmi_clk 0x1>, <&cru 0x1b>;
		clock-names = "clk_mali", "clk_gpu";
		power-domains = <&power 0x7>;
		#cooling-cells = <0x2>;
		operating-points-v2 = <&gpu_opp_table>;
		status = "okay";
		mali-supply = <&vdd_gpu>;

		gpu_power_model: power-model {
			compatible = "simple-power-model";
			leakage-range = <0x5 0xf>;
			ls = <0xffffa23e 0x5927 0x0>;
			static-coefficient = <0x186a0>;
			dynamic-coefficient = <0x3b9>;
			ts = <0xfffe56a6 0xf87a 0xfffffab5 0x14>;
			thermal-zone = "gpu-thermal";
		};
	};

	gpu_opp_table: opp-table2 {
		compatible = "operating-points-v2";
		mbist-vmin = <0xc96a8 0xdbba0 0xe7ef0>;
		nvmem-cells = <&gpu_leakage>, <&core_pvtm>, <&mbist_vmin>;
		nvmem-cell-names = "leakage", "pvtm", "mbist-vmin";
		rockchip,pvtm-voltage-sel = <0x0 0x14820 0x0 0x14821 0x153d8 0x1 0x153d9 0x16378
			0x2 0x16379 0x186a0 0x3>;
		rockchip,pvtm-ch = <0x0 0x5>;
		rockchip,temp-hysteresis = <0x2710>;
		rockchip,low-temp = <0x3a98>;
		rockchip,low-temp-adjust-volt = <0x0 0x384 0xc350>;

		opp-200000000 {
			opp-hz = <0x0 0xbebc200>;
			opp-microvolt = <0xcf850 0xcf850 0xf4240>;
		};

		opp-300000000 {
			opp-hz = <0x0 0x11e1a300>;
			opp-microvolt = <0xcf850 0xcf850 0xf4240>;
		};

		opp-400000000 {
			opp-hz = <0x0 0x17d78400>;
			opp-microvolt = <0xcf850 0xcf850 0xf4240>;
		};

		opp-600000000 {
			opp-hz = <0x0 0x23c34600>;
			opp-microvolt = <0xdbba0 0xdbba0 0xf4240>;
			opp-microvolt-L0 = <0xdbba0 0xdbba0 0xf4240>;
			opp-microvolt-L1 = <0xd59f8 0xd59f8 0xf4240>;
			opp-microvolt-L2 = <0xcf850 0xcf850 0xf4240>;
			opp-microvolt-L3 = <0xcf850 0xcf850 0xf4240>;
		};

		opp-700000000 {
			opp-hz = <0x0 0x29b92700>;
			opp-microvolt = <0xe7ef0 0xe7ef0 0xf4240>;
			opp-microvolt-L0 = <0xe7ef0 0xe7ef0 0xf4240>;
			opp-microvolt-L1 = <0xe1d48 0xe1d48 0xf4240>;
			opp-microvolt-L2 = <0xdbba0 0xdbba0 0xf4240>;
			opp-microvolt-L3 = <0xd59f8 0xd59f8 0xf4240>;
		};

		opp-800000000 {
			opp-hz = <0x0 0x2faf0800>;
			opp-microvolt = <0xf4240 0xf4240 0xf4240>;
			opp-microvolt-L0 = <0xf4240 0xf4240 0xf4240>;
			opp-microvolt-L1 = <0xee098 0xee098 0xf4240>;
			opp-microvolt-L2 = <0xe7ef0 0xe7ef0 0xf4240>;
			opp-microvolt-L3 = <0xe1d48 0xe1d48 0xf4240>;
		};
	};

	pvtm@fde80000 {
		compatible = "rockchip,rk3568-gpu-pvtm";
		reg = <0x0 0xfde80000 0x0 0x100>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		pvtm@1 {
			reg = <0x1>;
			clocks = <&cru 0x1e>, <&cru 0x1d>;
			clock-names = "clk", "pclk";
			resets = <&cru 0x24>, <&cru 0x23>;
			reset-names = "rts", "rst-p";
			thermal-zone = "gpu-thermal";
		};
	};

	pvtm@fde90000 {
		compatible = "rockchip,rk3568-npu-pvtm";
		reg = <0x0 0xfde90000 0x0 0x100>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		pvtm@2 {
			reg = <0x2>;
			clocks = <&cru 0x2b>, <&cru 0x2a>, <&cru 0x25>;
			clock-names = "clk", "pclk", "hclk";
			resets = <&cru 0x2e>, <&cru 0x2d>;
			reset-names = "rts", "rst-p";
			thermal-zone = "soc-thermal";
		};
	};

	vdpu: vdpu@fdea0400 {
		compatible = "rockchip,vpu-decoder-v2";
		reg = <0x0 0xfdea0400 0x0 0x400>;
		interrupts = <0x0 0x8b 0x4>;
		interrupt-names = "irq_dec";
		clocks = <&cru 0xee>, <&cru 0xef>;
		clock-names = "aclk_vcodec", "hclk_vcodec";
		resets = <&cru 0x11a>, <&cru 0x11b>;
		reset-names = "video_a", "video_h";
		iommus = <&vdpu_mmu>;
		power-domains = <&power 0xb>;
		rockchip,srv = <&mpp_srv>;
		rockchip,taskqueue-node = <0x0>;
		rockchip,resetgroup-node = <0x0>;
		status = "okay";
	};

	vdpu_mmu: iommu@fdea0800 {
		compatible = "rockchip,iommu-v2";
		reg = <0x0 0xfdea0800 0x0 0x40>;
		interrupts = <0x0 0x8a 0x4>;
		interrupt-names = "vdpu_mmu";
		clock-names = "aclk", "iface";
		clocks = <&cru 0xee>, <&cru 0xef>;
		power-domains = <&power 0xb>;
		#iommu-cells = <0x0>;
		status = "okay";
	};

	rk_rga: rk_rga@fdeb0000 {
		compatible = "rockchip,rga2";
		reg = <0x0 0xfdeb0000 0x0 0x1000>;
		interrupts = <0x0 0x5a 0x4>;
		clocks = <&cru 0xf3>, <&cru 0xf4>, <&cru 0xf5>;
		clock-names = "aclk_rga", "hclk_rga", "clk_rga";
		power-domains = <&power 0xa>;
		status = "okay";
	};

	ebc: ebc@fdec0000 {
