	dsi1: dsi@fe070000 {
		compatible = "rockchip,rk3568-mipi-dsi";
		reg = <0x0 0xfe070000 0x0 0x10000>;
		interrupts = <0x0 0x45 0x4>;
		clocks = <&cru 0xe9>, <&cru 0xda>, <&video_phy1>;
		clock-names = "pclk", "hclk", "hs_clk";
		resets = <&cru 0x111>;
		reset-names = "apb";
		phys = <&video_phy1>;
		phy-names = "mipi_dphy";
		power-domains = <&power 0x9>;
		rockchip,grf = <&grf>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		status = "disabled";

		ports {
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			dsi1_in: port@0 {
				reg = <0x0>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;

				dsi1_in_vp0: endpoint@0 {
					reg = <0x0>;
					remote-endpoint = <&vp0_out_dsi1>;
					status = "disabled";
				};

				dsi1_in_vp1: endpoint@1 {
					reg = <0x1>;
					remote-endpoint = <&vp1_out_dsi1>;
					status = "disabled";
				};
			};

			port@1 {
				reg = <0x1>;

				dsi1_out_panel: endpoint {
					remote-endpoint = <&panel_in_dsi1>;
				};
			};
		};

		dsi1_panel: panel@0 {
			status = "okay";
			compatible = "simple-panel-dsi";
			reg = <0x0>;
			backlight = <&backlight1>;
			reset-delay-ms = <30>;
			enable-delay-ms = <500>;
			prepare-delay-ms = <30>;
			init-delay-ms = <40>;
			unprepare-delay-ms = <30>;
			disable-delay-ms = <500>;
			dsi,flags = <0xa03>;
			dsi,format = <0>;
			dsi,lanes = <4>;
			panel-init-sequence = <0x5780111 0x51e0129>;
			panel-init-sequence-98818c = <0x5780111 0x51e0129>;
			panel-exit-sequence = <0x5000128 0x5000110>;
			power-supply = <&vcc3v3_lcd1_n>;

			display-timings {
				native-mode = <&dsi1_timing>;

				dsi1_timing: dsi1_timing {
					clock-frequency = <70000000>;
					hactive = <800>;
					vactive = <1280>;
					hfront-porch = <20>;
					hsync-len = <20>;
					hback-porch = <20>;
					vfront-porch = <30>;
					vsync-len = <4>;
					vback-porch = <8>;
					hsync-active = <0>;
					vsync-active = <0>;
					de-active = <0>;
					pixelclk-active = <1>;
				};

				dsi1_timing_default: timing_default {
					clock-frequency = <70000000>;
					hactive = <800>;
					vactive = <1280>;
					hfront-porch = <20>;
					hsync-len = <20>;
					hback-porch = <20>;
					vfront-porch = <30>;
					vsync-len = <4>;
					vback-porch = <8>;
					hsync-active = <0>;
					vsync-active = <0>;
					de-active = <0>;
					pixelclk-active = <1>;
				};
			};

			ports {
				#address-cells = <0x1>;
				#size-cells = <0x0>;

				port@0 {
					reg = <0x0>;

					panel_in_dsi1: endpoint {
						remote-endpoint = <&dsi1_out_panel>;
					};
				};
			};
		};
	};

	hdmi: hdmi@fe0a0000 {
		compatible = "rockchip,rk3568-dw-hdmi";
		reg = <0x0 0xfe0a0000 0x0 0x20000>;
		interrupts = <0x0 0x2d 0x4>;
		clocks = <&cru 0xe6>, <&cru 0xe7>, <&cru 0x193>, <&pmucru 0x2>, <&cru 0xde>;
		clock-names = "iahb", "isfr", "cec", "ref", "hclk";
		power-domains = <&power 0x9>;
		reg-io-width = <0x4>;
		rockchip,grf = <&grf>;
		#sound-dai-cells = <0x0>;
		pinctrl-names = "default";
		pinctrl-0 = <&hdmitx_scl>, <&hdmitx_sda>, <&hdmitxm0_cec>;
		status = "dsiabled";
		rockchip,phy-table = <0x58834d4 0x8009 0x0 0x270 0x9d5b340 0x800b 0x0 0x26d
			0xb1069a8 0x800b 0x0 0x1ed 0x11b3dc40 0x800b 0x0 0x1ad
			0x2367b880 0x8029 0x0 0x88 0x0 0x0 0x0 0x0>;

		ports {
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			hdmi_in: port@0 {
				reg = <0x0>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;

				hdmi_in_vp0: endpoint@0 {
					reg = <0x0>;
					remote-endpoint = <&vp0_out_hdmi>;
					status = "okay";
				};

				hdmi_in_vp1: endpoint@1 {
					reg = <0x1>;
					remote-endpoint = <&vp1_out_hdmi>;
					status = "disabled";
				};
			};
		};
	};

	edp: edp@fe0c0000 {
		compatible = "rockchip,rk3568-edp";
		reg = <0x0 0xfe0c0000 0x0 0x10000>;
		interrupts = <0x0 0x12 0x4>;
		clocks = <&pmucru 0x29>, <&cru 0xea>, <&cru 0xeb>, <&cru 0xda>;
		clock-names = "dp", "pclk", "spdif", "hclk";
		resets = <&cru 0x113>, <&cru 0x112>;
		reset-names = "dp", "apb";
		phys = <&edp_phy>;
		phy-names = "dp";
		power-domains = <&power 0x9>;
		status = "disabled";
		force-hpd;

		ports {
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			edp_in: port@0 {
				reg = <0x0>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;

				edp_in_vp0: endpoint@0 {
					reg = <0x0>;
					remote-endpoint = <&vp0_out_edp>;
					status = "okay";
				};

				edp_in_vp1: endpoint@1 {
					reg = <0x1>;
					remote-endpoint = <&vp1_out_edp>;
					status = "disabled";
				};
			};

			port@1 {
				reg = <0x1>;

				edp_out: endpoint {
					remote-endpoint = <&panel_in>;
				};
			};
		};
	};

