	sdmmc2: dwmmc@fe000000 {
		compatible = "rockchip,rk3568-dw-mshc", "rockchip,rk3288-dw-mshc";
		reg = <0x0 0xfe000000 0x0 0x4000>;
		interrupts = <0x0 0x64 0x4>;
		max-frequency = <150000000>;
		clocks = <&cru 0xc1>, <&cru 0xc2>, <&cru 0x18e>, <&cru 0x18f>;
		clock-names = "biu", "ciu", "ciu-drive", "ciu-sample";
		fifo-depth = <0x100>;
		resets = <&cru 0xeb>;
		reset-names = "reset";
		status = "disabled";
		supports-sdio;
		bus-width = <4>;
		disable-wp;
		cap-sd-highspeed;
		cap-sdio-irq;
		keep-power-in-suspend;
		mmc-pwrseq = <&sdio_pwrseq>;
		non-removable;
		pinctrl-names = "default";
		pinctrl-0 = <&sdmmc2m0_bus4>, <&sdmmc2m0_cmd>, <&sdmmc2m0_clk>;
		sd-uhs-sdr104;
	};

	dfi: dfi@fe230000 {
		reg = <0x0 0xfe230000 0x0 0x400>;
		compatible = "rockchip,rk3568-dfi";
		rockchip,pmugrf = <&pmugrf>;
		status = "okay";
	};

	dmc: dmc {
		compatible = "rockchip,rk3568-dmc";
		interrupts = <0x0 0xa 0x4>;
		interrupt-names = "complete";
		devfreq-events = <&dfi>, <&nocp_cpu>;
		clocks = <&scmi_clk 0x3>;
		clock-names = "dmc_clk";
		operating-points-v2 = <&dmc_opp_table>;
		vop-bw-dmc-freq = <0x0 0x11e 0x4f1a0 0x11f 0x1869f 0x80e80>;
		vop-frame-bw-dmc-freq = <0x0 0x26c 0x4f1a0 0x26d 0x1869f 0xbe6e0>;
		cpu-bw-dmc-freq = <0x0 0x15e 0x4f1a0 0x15f 0x190 0x80e80 0x191 0x1869f 0xbe6e0>;
		upthreshold = <0x28>;
		downdifferential = <0x14>;
		system-status-level = <0x1 0x4 0x8 0x8 0x2 0x1 0x10 0x4
			0x10000 0x4 0x1000 0x8 0x4000 0x8 0x2000 0x8
			0xc00 0x8>;
		auto-min-freq = <0x4f1a0>;
		auto-freq-en = <0x1>;
		#cooling-cells = <0x2>;
		status = "okay";
		center-supply = <&vdd_logic>;
	};

	dmc_fsp: dmc-fsp {
		compatible = "rockchip,rk3568-dmc-fsp";
		debug_print_level = <0x0>;
		ddr3_params = <&ddr3_params>;
		ddr4_params = <&ddr4_params>;
		lpddr3_params = <&lpddr3_params>;
		lpddr4_params = <&lpddr4_params>;
		lpddr4x_params = <&lpddr4x_params>;
		status = "okay";
	};

	dmc_opp_table: dmc-opp-table {
		compatible = "operating-points-v2";
		mbist-vmin = <0xc96a8 0xdbba0 0xe7ef0>;
		nvmem-cells = <&log_leakage>, <&core_pvtm>, <&mbist_vmin>;
		nvmem-cell-names = "leakage", "pvtm", "mbist-vmin";
		rockchip,temp-hysteresis = <0x2710>;
		rockchip,low-temp = <0x3a98>;
		rockchip,low-temp-adjust-volt = <0x0 0x618 0x124f8>;
		rockchip,leakage-voltage-sel = <0x1 0x50 0x0 0x51 0xfe 0x1>;
		rockchip,pvtm-voltage-sel = <0x0 0x153d8 0x0 0x153d9 0x186a0 0x1>;
		rockchip,pvtm-ch = <0x0 0x5>;

		opp-1560000000 {
			opp-hz = <0x0 0x5cfbb600>;
			opp-microvolt = <0xdbba0>;
			opp-microvolt-L0 = <0xdbba0>;
			opp-microvolt-L1 = <0xd59f8>;
		};
	};

	dmcdbg: dmcdbg {
		compatible = "rockchip,rk3568-dmcdbg";
		status = "disabled";
	};

	pcie2x1: pcie@fe260000 {
		compatible = "rockchip,rk3568-pcie", "snps,dw-pcie";
		#address-cells = <0x3>;
		#size-cells = <0x2>;
		bus-range = <0x0 0xf>;
		clocks = <&cru 0x81>, <&cru 0x82>, <&cru 0x83>, <&cru 0x84>, <&cru 0x85>;
		clock-names = "aclk_mst", "aclk_slv", "aclk_dbi", "pclk", "aux";
		device_type = "pci";
		interrupts = <0x0 0x4b 0x4 0x0 0x4a 0x4 0x0 0x49 0x4 0x0 0x48 0x4 0x0 0x47 0x4>;
		interrupt-names = "sys", "pmc", "msg", "legacy", "err";
		#interrupt-cells = <0x1>;
		interrupt-map-mask = <0x0 0x0 0x0 0x7>;
		interrupt-map = <0x0 0x0 0x0 0x1 0xb6 0x0 0x0 0x0
			0x0 0x2 0xb6 0x1 0x0 0x0 0x0 0x3
			0xb6 0x2 0x0 0x0 0x0 0x4 0xb6 0x3>;
		linux,pci-domain = <0x0>;
		num-ib-windows = <0x6>;
		num-viewport = <0x8>;
		num-ob-windows = <0x2>;
		max-link-speed = <0x2>;
		msi-map = <0x0 0xb7 0x0 0x1000>;
		num-lanes = <0x1>;
		phys = <&combphy2_psq 0x2>;
		phy-names = "pcie-phy";
		power-domains = <&power 0xf>;
		ranges = <0x800 0x0 0xf4000000 0x0 0xf4000000 0x0 0x100000 0x81000000
			0x0 0xf4100000 0x0 0xf4100000 0x0 0x100000 0x82000000 0x0
			0xf4200000 0x0 0xf4200000 0x0 0x1e00000 0xc3000000 0x3 0x0
			0x3 0x0 0x0 0x40000000>;
		reg = <0x3 0xc0000000 0x0 0x400000 0x0 0xfe260000 0x0 0x10000>;
		reg-names = "pcie-dbi", "pcie-apb";
		resets = <&cru 0xa1>;
		reset-names = "pipe";
		status = "disabled";

		pcie2x1_intc: legacy-interrupt-controller {
			interrupt-controller;
			#address-cells = <0x0>;
			#interrupt-cells = <0x1>;
			interrupt-parent = <&gic>;
			interrupts = <0x0 0x48 0x1>;
		};
	};

