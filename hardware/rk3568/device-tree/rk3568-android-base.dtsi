	otp: otp@fe38c000 {
		compatible = "rockchip,rk3568-otp";
		reg = <0x0 0xfe38c000 0x0 0x4000>;
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		clocks = <&cru 0x73>, <&cru 0x72>, <&cru 0x71>, <&cru 0x181>;
		clock-names = "usr", "sbpi", "apb", "phy";
		resets = <&cru 0x1cf>;
		reset-names = "otp_phy";

		cpu_code: cpu-code@2 {
			reg = <0x2 0x2>;
		};

		otp_cpu_version: cpu-version@8 {
			reg = <0x8 0x1>;
			bits = <0x3 0x3>;
		};

		mbist_vmin: mbist-vmin@9 {
			reg = <0x9 0x1>;
			bits = <0x0 0x4>;
		};

		otp_id: id@a {
			reg = <0xa 0x10>;
		};

		cpu_leakage: cpu-leakage@1a {
			reg = <0x1a 0x1>;
		};

		log_leakage: log-leakage@1b {
			reg = <0x1b 0x1>;
		};

		npu_leakage: npu-leakage@1c {
			reg = <0x1c 0x1>;
		};

		gpu_leakage: gpu-leakage@1d {
			reg = <0x1d 0x1>;
		};

		core_pvtm: core-pvtm@2a {
			reg = <0x2a 0x2>;
		};
	};

