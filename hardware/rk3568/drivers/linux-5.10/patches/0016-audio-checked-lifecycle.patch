+	mutex_lock(&rk817->params_lock);
+	if (rk817->terminal_started) {
+		mutex_unlock(&rk817->params_lock);
+		return;
+	}
+	if (!rk817->params_error)
+		rk817->params_error = first_errno < 0 ? first_errno : -EIO;
+	mutex_unlock(&rk817->params_lock);
+}
