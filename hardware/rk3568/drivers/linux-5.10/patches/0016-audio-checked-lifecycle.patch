+	i2s_tdm->trcm_active[ss->stream] = ss;
+	i2s_tdm->starting &= ~bit;
+	i2s_tdm->starting_valid &= ~bit;
+	i2s_tdm->trcm_ticket[ss->stream] = NULL;
+	i2s_tdm->trcm_ticket_epoch[ss->stream] = 0;
+	return 0;
+}
