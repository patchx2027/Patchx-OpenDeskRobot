+	spin_lock_irqsave(&i2s_tdm->lock, flags);
+	i2s_checked_error_locked(i2s_tdm, first_errno < 0 ? first_errno : -EIO);
+	spin_unlock_irqrestore(&i2s_tdm->lock, flags);
+}
