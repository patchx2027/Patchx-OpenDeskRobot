+	if (!cookie || p->cookie != cookie || p->pending != ss ||
+	    p->transaction != ss || !p->undo || !p->applied)
+		return -EINVAL;
+	p->owner[ss->stream] = ss;
+	dai->rate = 48000;
+	dai->channels = 2;
+	dai->sample_bits = 16;
+	p->pending = NULL;
