+	    (dai->rate != 48000 || dai->channels != 2 || dai->sample_bits != 16))
+		return -EINVAL;
+	p->generation++;
+	p->cookie = p->generation;
+	p->transaction = ss;
+	p->pending = ss;
+	p->old_owner = p->owner[stream];
+	p->old_rate = dai->rate;
+	p->old_channels = dai->channels;
+	p->old_sample_bits = dai->sample_bits;
+	p->reuse = p->owner[0] || p->owner[1];
+	p->applied = false;
+	p->undo = true;
+	*cookie = p->cookie;
+	return 0;
